# macOS
.DS_Store

# VS Code local settings
.vscode/

# Python
__pycache__/
*.pyc
.venv/
venv/

# C / C++ / CUDA build
build/
cmake-build-*/
*.o
*.so
*.a

# Logs
*.log

# Nsight Systems / Compute large profiling files
*.nsys-rep
*.qdrep
*.ncu-rep

# Raw benchmark data can become large.
# Keep the small text artifacts that make a run reproducible — verbatim tool
# output, env.json, run_manifest.json — and exclude everything else (dumps,
# archives, traces). Reproducibility requires the raw evidence to be in git.
results/raw/*
!results/raw/.gitkeep
!results/raw/*/
results/raw/*/*
!results/raw/*/*.txt
!results/raw/*/*.json
!results/raw/*/*.csv
# Failure notes explain preserved failed runs and are referenced from the
# experiment reports; the allowlist above silently excluded them until the
# Phase 11 audit. Build logs stay excluded — they are artifacts, not evidence.
!results/raw/*/*.md

profiles/raw/*
!profiles/raw/.gitkeep
