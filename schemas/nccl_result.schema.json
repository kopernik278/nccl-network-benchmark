{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kopernik278/nccl-network-benchmark/schemas/nccl_result.schema.json",
  "title": "NCCL benchmark result row",
  "description": "One measurement point from a GPU collective communication benchmark. Canonical storage is JSON Lines: one object of this shape per line. See docs/design/RFC-001-result-schema.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "phase",
    "timestamp",
    "value_kind",
    "benchmark_tool",
    "collective",
    "datatype",
    "message_size_bytes",
    "placement",
    "warmup_iterations",
    "measured_iterations",
    "repeat_index",
    "node_count",
    "gpu_count",
    "correctness_ok",
    "command"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1,
      "description": "p1-<slug>-<UTC timestamp>-<git short sha>"
    },
    "phase": {
      "type": "string",
      "pattern": "^phase[0-9]$"
    },
    "timestamp": {
      "type": "string",
      "description": "UTC ISO 8601, e.g. 2026-08-26T14:15:30Z"
    },
    "git_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "git_dirty": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "value_kind": {
      "enum": [
        "measured",
        "estimated",
        "theoretical",
        "synthetic"
      ],
      "description": "Integrity interlock. Only rows parsed from real tool output may be 'measured'."
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider_instance_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "hostname": {
      "type": [
        "string",
        "null"
      ]
    },
    "os": {
      "type": [
        "string",
        "null"
      ]
    },
    "kernel": {
      "type": [
        "string",
        "null"
      ]
    },
    "cpu_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "cpu_cores": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "node_count": {
      "type": "integer",
      "minimum": 1
    },
    "gpu_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "gpu_count": {
      "type": "integer",
      "minimum": 1
    },
    "gpus": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "index": {
            "type": [
              "integer",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "pci_bus_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "memory_total_mib": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "topology": {
      "type": [
        "string",
        "null"
      ],
      "description": "Verbatim nvidia-smi topo -m output"
    },
    "topology_summary": {
      "type": [
        "string",
        "null"
      ],
      "description": "Dominant inter-GPU link class, e.g. PIX, PHB, NODE, SYS, NV12"
    },
    "network": {
      "type": [
        "string",
        "null"
      ],
      "description": "none-single-node | tcp | roce | infiniband. Must reflect the fabric actually used."
    },
    "nvlink_present": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "p2p_enabled": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "cuda_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "driver_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "nccl_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "nccl_version_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "mpi_version": {
      "type": [
        "string",
        "null"
      ],
      "description": "null in Phase 1: nccl-tests runs single-process multi-GPU, MPI intentionally unused."
    },
    "compiler_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "nccl_tests_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "benchmark_tool": {
      "type": "string",
      "description": "nccl-tests | custom-ring-allreduce | ..."
    },
    "collective": {
      "enum": [
        "all_reduce",
        "all_gather",
        "reduce_scatter",
        "broadcast",
        "p2p"
      ]
    },
    "datatype": {
      "type": "string"
    },
    "redop": {
      "type": [
        "string",
        "null"
      ]
    },
    "root": {
      "type": [
        "integer",
        "null"
      ]
    },
    "message_size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "count_elements": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "placement": {
      "enum": [
        "out_of_place",
        "in_place"
      ]
    },
    "warmup_iterations": {
      "type": "integer",
      "minimum": 0
    },
    "measured_iterations": {
      "type": "integer",
      "minimum": 1
    },
    "repeat_index": {
      "type": "integer",
      "minimum": 0
    },
    "tier": {
      "type": [
        "string",
        "null"
      ],
      "description": "smoke | full"
    },
    "latency_us": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Mean wall time of one collective, microseconds"
    },
    "algorithmic_bandwidth_gbps": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "GB/s = 10^9 BYTES per second (decimal), NOT gigabits"
    },
    "bus_bandwidth_gbps": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "GB/s = 10^9 BYTES per second (decimal), NOT gigabits"
    },
    "wrong_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "correctness_ok": {
      "type": "boolean"
    },
    "out_of_bounds_ok": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "bandwidth_ratio_ok": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Hypothesis H5: busbw == algbw * factor(collective, ranks). A units/rank-count self-check. null when algbw is too small to test at the printed precision."
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "env": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      },
      "description": "Allowlisted and redacted environment variables"
    },
    "raw_output_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "hosts": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "Hostnames participating in the run (multi-node)."
    },
    "rank_to_host": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      },
      "description": "Rank index -> hostname, parsed from NCCL/nccl-tests runtime output."
    },
    "ranks_per_node": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "net_interface": {
      "type": [
        "string",
        "null"
      ],
      "description": "Interface NCCL was explicitly pointed at (NCCL_SOCKET_IFNAME). Never guessed."
    },
    "transport": {
      "type": [
        "string",
        "null"
      ],
      "description": "Transport proven from runtime evidence, e.g. NET/Socket, NET/IB, P2P/direct."
    },
    "transport_verified": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "True only when a transport check passed against NCCL_DEBUG=INFO output. A performance row with false/null must not be used for a transport comparison."
    },
    "mpi_implementation": {
      "type": [
        "string",
        "null"
      ]
    },
    "launcher": {
      "type": [
        "string",
        "null"
      ],
      "description": "mpirun, srun, or null for single-process runs."
    },
    "config_label": {
      "type": [
        "string",
        "null"
      ],
      "description": "Label distinguishing NCCL configurations that share one experiment (Phase 5), e.g. auto, ring-simple."
    },
    "nccl_algo": {
      "type": [
        "string",
        "null"
      ],
      "description": "Value forced via NCCL_ALGO (Ring, Tree, ...). Null when NCCL selected automatically."
    },
    "nccl_proto": {
      "type": [
        "string",
        "null"
      ],
      "description": "Value forced via NCCL_PROTO (Simple, LL, LL128). Null when NCCL selected automatically."
    },
    "nccl_extra_env": {
      "type": [
        "string",
        "null"
      ],
      "description": "Verbatim extra NCCL environment applied to this run."
    },
    "t_compute_us": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Standalone compute duration (Phase 7B)."
    },
    "t_comm_us": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Standalone communication duration (Phase 7B)."
    },
    "t_seq_us": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Fully serialised compute-then-communicate."
    },
    "t_overlap_us": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Both issued concurrently on separate streams."
    },
    "t_ideal_us": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "max(t_compute, t_comm) \u2014 perfect overlap."
    },
    "overlap_efficiency": {
      "type": [
        "number",
        "null"
      ],
      "description": "(t_seq - t_overlap) / (t_seq - t_ideal). End-to-end; null when the denominator is too small to be meaningful."
    },
    "exposed_comm_us": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "max(0, t_overlap - t_compute). End-to-end exposure, NOT proof of the collective's own duration."
    },
    "compute_during_overlap_us": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Compute-stream duration measured by CUDA events while communication ran \u2014 for interference."
    },
    "comm_during_overlap_us": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Comm-stream duration measured by CUDA events while compute ran \u2014 for interference."
    },
    "bucket_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "DDP-like bucket granularity."
    },
    "n_buckets": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "compute_reps": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "GEMM repetitions used to hit the target compute duration."
    },
    "workload_class": {
      "type": [
        "string",
        "null"
      ],
      "description": "Phase 8 compute workload class: compute-gemm | memory-triad | mixed. Arithmetic intensity is by construction unless counter-verified."
    }
  }
}
